+	public static boolean isQmj5QuiltMod(Path jar) {
+		try {
+			return ZipUtils.contains(jar, QUILT_MOD_JSON5);
+		} catch (UncheckedIOException e) {
+			if (e.getCause() instanceof NoSuchFileException) {
+				return false;
+			} else {
