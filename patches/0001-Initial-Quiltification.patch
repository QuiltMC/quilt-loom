--- a/build.gradle
+++ b/build.gradle
@@ -22,7 +22,7 @@ tasks.withType(org.jetbrains.kotlin.gradle.tasks.KotlinCompile).all {
 	}
 }
 
-group = 'net.fabricmc'
+group = 'org.quiltmc'
 def baseVersion = '1.14'
 
 def ENV = System.getenv()
@@ -234,23 +234,42 @@ codenarc {
 
 gradlePlugin {
 	plugins {
-		fabricLoom {
-			id = 'net.fabricmc.fabric-loom'
+		quiltLoom {
+			id = 'org.quiltmc.loom.no_remap'
 			implementationClass = 'net.fabricmc.loom.LoomNoRemapGradlePlugin'
 		}
-		fabricLoomRemap {
-			id = 'net.fabricmc.fabric-loom-remap'
+		quiltLoomRemap {
+			id = 'org.quiltmc.loom.remap'
 			implementationClass = 'net.fabricmc.loom.LoomRemapGradlePlugin'
 		}
-		fabricLoomLegacy {
-			// Legacy plugin id, remove in 2.0. Use `net.fabricmc.fabric-loom-remap`
-			id = 'fabric-loom'
+		quiltLoomLegacy {
+			// Legacy plugin id. Use `org.quiltmc.loom.remap`
+			id = 'org.quiltmc.loom'
 			implementationClass = 'net.fabricmc.loom.LoomGradlePlugin'
 		}
-		fabricLoomCompanion {
-			id = 'net.fabricmc.fabric-loom-companion'
+		quiltLoomCompanion {
+			id = 'org.quiltmc.loom.companion'
 			implementationClass = 'net.fabricmc.loom.LoomCompanionGradlePlugin'
 		}
+		if (!ENV.MAVEN_URL) {
+			fabricLoom {
+				id = 'net.fabricmc.fabric-loom'
+				implementationClass = 'net.fabricmc.loom.LoomNoRemapGradlePlugin'
+			}
+			fabricLoomRemap {
+				id = 'net.fabricmc.fabric-loom-remap'
+				implementationClass = 'net.fabricmc.loom.LoomRemapGradlePlugin'
+			}
+			fabricLoomLegacy {
+				// Legacy plugin id, remove in 2.0. Use `net.fabricmc.fabric-loom-remap`
+				id = 'fabric-loom'
+				implementationClass = 'net.fabricmc.loom.LoomGradlePlugin'
+			}
+			fabricLoomCompanion {
+				id = 'net.fabricmc.fabric-loom-companion'
+				implementationClass = 'net.fabricmc.loom.LoomCompanionGradlePlugin'
+			}
+		}
 	}
 }
 
